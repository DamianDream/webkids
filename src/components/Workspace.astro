---
---
<main class="froggy-container" id="main-workspace">
  
  <!-- LEFT COLUMN: Instructions, Code Editor & Level Nav -->
  <div class="froggy-left-pane">
    
    <!-- Top Bar: Brand, Agent Profile, Level Switcher, XP -->
    <div class="froggy-top-bar">
      <div class="froggy-brand">
        <span class="brand-avatar-badge">🕵️‍♂️</span>
        <span class="brand-name">ВЕБ-АГЕНТЫ</span>
      </div>

      <!-- Agent Profile Mini Pill -->
      <div class="froggy-agent-pill">
        <button class="agent-mini-avatar" id="agent-avatar" title="Сменить аватар">🕵️‍♂️</button>
        <input type="text" id="agent-name-input" class="agent-name-input" value="Агент 007" title="Позывной" />
      </div>

      <!-- Froggy Level Navigation -->
      <div class="froggy-level-nav">
        <button class="btn-level-arrow" id="prev-level-btn" title="Предыдущий уровень">◄</button>
        <button class="btn-level-dropdown" id="level-dropdown-btn">
          <span id="level-dropdown-text">Уровень 1 из 15</span>
          <span style="font-size: 10px; color: #64748b;">▼</span>
        </button>
        <button class="btn-level-arrow" id="next-level-btn-top" title="Следующий уровень">►</button>

        <!-- Level Selector Popover (Froggy Style) -->
        <div class="level-picker-popover" id="level-picker-popover">
          <div class="level-picker-title">Карта Миссий Спецагента</div>
          <div class="level-picker-grid" id="level-picker-grid">
            <!-- Dynamically generated levels -->
          </div>
        </div>
      </div>

      <!-- XP Badge -->
      <div class="froggy-xp-badge">
        <span>⭐</span>
        <b id="current-xp-num">0</b>
        <span style="font-size: 11px; color: #b45309;">XP</span>
      </div>
    </div>

    <!-- Instructions / Briefing Section -->
    <div class="froggy-instructions">
      <div class="froggy-case-tag" id="briefing-badge">ДЕЛО №000: Чертёж сайта</div>
      <h1 class="froggy-step-headline" id="step-headline">Загрузка задания...</h1>
      <div class="froggy-story-text" id="step-explanation">Объяснение...</div>
      
      <!-- Formula & Task Callout -->
      <div class="froggy-formula-row">
        <div class="froggy-formula-box">
          <span class="formula-label">Формула тега:</span>
          <code id="step-formula" class="formula-code">&lt;tag&gt;...&lt;/tag&gt;</code>
        </div>
        <div class="froggy-task-box">
          <span class="task-box-icon">🎯</span>
          <span id="task-single-text" class="task-single-text">Напиши тег своими руками</span>
        </div>
      </div>
    </div>

    <!-- Code Editor Card (Froggy Style with Line Numbers) -->
    <div class="froggy-editor-card">
      <div class="froggy-editor-body">
        <!-- Line Numbers Gutter -->
        <div class="editor-gutter" id="editor-gutter">
          <div>1</div>
          <div>2</div>
          <div>3</div>
          <div>4</div>
          <div>5</div>
          <div>6</div>
          <div>7</div>
        </div>

        <!-- Code Content Area -->
        <div class="editor-code-pane">
          <!-- Top Skeleton Lines -->
          <div id="skel-doctype" class="code-locked-line">&lt;!DOCTYPE html&gt; <span class="skel-tag-note">← Паспорт сайта</span></div>
          <div id="skel-html" class="code-locked-line">&lt;html lang="ru"&gt; <span class="skel-tag-note">← Стены дома</span></div>
          <div id="skel-head" class="code-locked-line">&nbsp;&nbsp;&lt;head&gt;&lt;title&gt;Секретный Штаб&lt;/title&gt;&lt;/head&gt;</div>
          <div id="skel-body" class="code-locked-line">&nbsp;&nbsp;&lt;body&gt; <span class="skel-tag-note" style="color: #059669; font-weight: bold;">← Твоя зона! Пиши свои теги здесь:</span></div>
          
          <!-- Editable Code Zone -->
          <textarea id="code-editor" class="code-editable-area" spellcheck="false" placeholder="Напиши теги своими руками здесь..."></textarea>
          
          <!-- Bottom Skeleton Lines -->
          <div id="skel-body-end" class="code-locked-line">&nbsp;&nbsp;&lt;/body&gt; <span class="skel-tag-note">← Конец body</span></div>
          <div id="skel-html-end" class="code-locked-line">&lt;/html&gt; <span class="skel-tag-note">← Замок дома</span></div>
        </div>
      </div>

      <!-- Bottom Toolbar inside Editor Card (Froggy Action Bar) -->
      <div class="froggy-editor-actions">
        <!-- Quick Stickers Toolbar -->
        <div class="froggy-stickers">
          <span class="stickers-label-mini">Шпаргалка:</span>
          <button class="sticker-pill-mini" data-start="<h1>" data-end="</h1>">+ &lt;h1&gt;</button>
          <button class="sticker-pill-mini" data-start="<p>" data-end="</p>">+ &lt;p&gt;</button>
          <button class="sticker-pill-mini" data-start="<b>" data-end="</b>">+ &lt;b&gt;</button>
          <button class="sticker-pill-mini" data-start="<i>" data-end="</i>">+ &lt;i&gt;</button>
          <button class="sticker-pill-mini" data-start="<ul>\n  <li>" data-end="</li>\n</ul>">+ &lt;ul&gt;</button>
          <button class="sticker-pill-mini" data-start="<img src='https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=400' width='240'>" data-end="">+ &lt;img&gt;</button>
          <button class="sticker-pill-mini" data-start="<a href='https://wikipedia.org' target='_blank'>" data-end="</a>">+ &lt;a&gt;</button>
          <button class="sticker-pill-mini" data-start="<button class='fun-btn' onclick='alert(&quot;Код принят!&quot;)'>" data-end="</button>">+ &lt;button&gt;</button>
          <button class="sticker-pill-mini" data-start="<style>\n  body { background: #f0fdf4; color: #166534; }\n</style>\n" data-end="">+ &lt;style&gt;</button>
        </div>

        <!-- Froggy Action Buttons -->
        <div class="froggy-action-buttons">
          <button class="btn-action-run" id="run-code-btn" title="Запустить код на планшете iPad">
            <span class="btn-icon">▶</span>
            <span>Запустить</span>
          </button>
          <button class="btn-action-check" id="check-code-btn" title="Проверить задание и получить XP">
            <span class="btn-icon">✓</span>
            <span>Проверить</span>
          </button>
          <button class="btn-action-next" id="next-level-btn" title="Следующий уровень">
            <span>Дальше →</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Minimal Footer (Links & Stats) -->
    <div class="froggy-footer">
      <div class="froggy-footer-links">
        <button class="froggy-footer-link" id="footer-tags-btn">📖 Книга Тегов</button>
        <button class="froggy-footer-link" id="footer-cert-btn">🏆 Золотой Диплом</button>
        <button class="froggy-footer-link" id="sound-btn" title="Звук: ВКЛ">🔊 Звук: ВКЛ</button>
        <button class="froggy-footer-link" id="reset-btn" title="Сбросить весь прогресс">🔄 Начать заново</button>
      </div>
      <div class="froggy-save-status">
        <span class="save-indicator-dot"></span>
        <span>💾 Автосохранение</span>
      </div>
    </div>

  </div>

  <!-- RIGHT COLUMN: Visual Stage (Pond Simulator Area) -->
  <div class="froggy-right-pane">
    
    <!-- 100% Vector Scalable Apple iPad Pro Simulator -->
    <div class="ipad-vector-chassis">
      <div class="ipad-vector-bezel">
        
        <!-- Apple Face ID & Camera Sensor Bar -->
        <div class="ipad-vector-sensors">
          <span class="sensor-dot"></span>
          <span class="camera-lens"></span>
          <span class="sensor-dot"></span>
        </div>

        <!-- iPad Glass Display Area -->
        <div class="ipad-vector-screen">
          
          <!-- iOS Status Bar -->
          <div class="ipad-status-bar">
            <span>9:41 AM</span>
            <span style="font-weight: 800; color: #2563eb;">iPad Спецагента</span>
            <span>100% 🔋</span>
          </div>

          <!-- Safari Browser Bar -->
          <div class="safari-browser-bar">
            <div class="browser-nav-btns">
              <span>‹</span>
              <span>›</span>
            </div>
            
            <div class="safari-url-pill">
              <span>🔒</span>
              <span id="safari-url-text">agent-net.secret/level-1.html</span>
            </div>

            <div class="safari-reload-icon" id="safari-reload-btn" title="Обновить сайт">
              🔄
            </div>
          </div>

          <!-- Live Website Frame inside iPad -->
          <iframe id="preview-frame" class="live-display-frame-vector"></iframe>

          <!-- Floating Run Notification Toast on iPad -->
          <div id="ipad-run-toast" class="ipad-run-toast">🚀 Сайт запущен на iPad</div>

          <!-- iOS Bottom Home Indicator Bar -->
          <div class="ios-home-indicator-bar"></div>
        </div>

      </div>
    </div>

  </div>

</main>
