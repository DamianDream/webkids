---
---
<div class="light-modal-overlay" id="quiz-modal-overlay">
  <div class="quiz-modal-card">
    
    <!-- Top Header -->
    <div class="quiz-modal-header">
      <div class="quiz-badge-wrap">
        <span class="quiz-badge-pill" id="quiz-badge">🎯 ВИКТОРИНА АГЕНТА</span>
        <h3 class="quiz-block-title" id="quiz-block-title">Дело №0: Чертёж сайта</h3>
      </div>
      <button class="quiz-close-x" id="quiz-close-x" title="Закрыть">✕</button>
    </div>

    <!-- Active Question View -->
    <div id="quiz-question-view" class="quiz-view-active">
      <div class="quiz-progress-row">
        <span class="quiz-step-text" id="quiz-step-text">Вопрос 1 из 3</span>
        <div class="quiz-progress-track">
          <div class="quiz-progress-bar" id="quiz-progress-fill" style="width: 33%;"></div>
        </div>
      </div>

      <div class="quiz-question-bubble">
        <div class="quiz-q-num" id="quiz-q-num">Вопрос 1:</div>
        <div class="quiz-q-title" id="quiz-q-title">Какой тег сообщает браузеру, что документ написан на HTML5?</div>
      </div>

      <div class="quiz-options-grid" id="quiz-options-list">
        <!-- Rendered dynamically -->
      </div>
    </div>

    <!-- Results & Corrections View -->
    <div id="quiz-result-view" style="display: none;">
      <div class="quiz-result-hero">
        <div class="quiz-result-icon" id="quiz-result-icon">🏆</div>
        <h4 class="quiz-result-heading" id="quiz-result-heading">Отличная работа!</h4>
        <p class="quiz-result-sub" id="quiz-result-score">Правильных ответов: 3 из 3</p>
      </div>

      <div class="quiz-breakdown-container" id="quiz-breakdown-list">
        <!-- Questions review breakdown rendered dynamically -->
      </div>

      <div class="quiz-footer-actions">
        <button class="btn-quiz-retry" id="quiz-retry-btn">🔄 Пройти заново</button>
        <button class="btn-quiz-continue" id="quiz-continue-btn">Продолжить путь 🚀</button>
      </div>
    </div>

  </div>
</div>
