---
---
<header class="app-compact-header">
  <!-- Brand -->
  <div class="brand-compact">
    <span class="brand-avatar-badge">🕵️‍♂️</span>
    <span class="brand-name">Веб-Агенты</span>
  </div>

  <!-- Agent Quick Status Bar -->
  <div class="agent-quick-bar">
    <button class="agent-mini-avatar" id="agent-avatar" title="Сменить маскировку">🕵️‍♂️</button>
    <input type="text" id="agent-name-input" class="agent-name-compact" value="Агент 007" title="Позывной" />
    <span class="agent-rank-badge" id="agent-rank">Стажёр 🕶️</span>

    <!-- Slim XP Bar -->
    <div class="xp-mini-wrap">
      <div class="xp-mini-track">
        <div class="xp-meter-bar" id="xp-bar-fill"></div>
      </div>
      <span class="xp-mini-text"><b id="current-xp-num">0</b>/1500 XP</span>
    </div>
  </div>

  <!-- Quick Nav Tabs -->
  <div class="header-right-nav">
    <div class="tab-toggle-group">
      <button class="tab-btn active" id="nav-missions-btn">🎯 Задания</button>
      <button class="tab-btn" id="nav-tags-btn">📖 Книга Тегов</button>
      <button class="tab-btn" id="cert-open-btn">🏆 Диплом</button>
    </div>
    
    <div class="util-btns">
      <button class="mini-icon-btn" id="sound-btn" title="Звук: ВКЛ">🔊</button>
      <button class="mini-icon-btn" id="reset-btn" title="Сбросить прогресс">🔄</button>
    </div>
  </div>
</header>
