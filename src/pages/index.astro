---
import Layout from '../layouts/Layout.astro';
import Workspace from '../components/Workspace.astro';
import TagsLibrary from '../components/TagsLibrary.astro';
import Certificate from '../components/Certificate.astro';
import Modal from '../components/Modal.astro';
import QuizModal from '../components/QuizModal.astro';
---

<Layout title="Академия Веб-Агентов | Интерактивный тренажер HTML + CSS">
  <Workspace />
  <TagsLibrary />
  <Certificate />
  <Modal />
  <QuizModal />

  <script is:inline>
    // -------------------------------------------------------------
    // TAGS ENCYCLOPEDIA (КНИГА ТЕГОВ)
    // -------------------------------------------------------------
    const ALL_TAGS = [
