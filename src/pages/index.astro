    // -------------------------------------------------------------
    // CHECK CODE & TASK VALIDATION
    // -------------------------------------------------------------
    function checkCode() {
      playSound('click');
      updatePreview();

      const lvl = LEVELS[state.currentLevelIndex];
      const step = lvl.step;
      const textarea = document.getElementById("code-editor");
      const code = textarea ? textarea.value.trim() : "";

      let count = 0;
      let earnedXp = 0;

      step.tasks.forEach(task => {
        if (!state.completedTasks.includes(task.id)) {
          if (task.check && task.check(code)) {
            state.completedTasks.push(task.id);
            state.xp += task.xp;
            earnedXp += task.xp;
            count++;
          }
        }
      });

      if (count > 0) {
        playSound('win');
        launchConfetti();
        showIpadToast(`🌟 Задание выполнено! +${earnedXp} XP`);

        const modalMsg = step.isIntroOnly
          ? `Отлично! Ты успешно изучил тег ${step.tag}!\nЗачислено +${earnedXp} XP!\n\nЖми 'Дальше →' для следующего уровня!`
          : `Шифр проверен! Выполнено заданий: ${count}. Зачислено +${earnedXp} XP!\n\nТвой сайт отобразился на iPad! Жми 'Дальше →'!`;

        showModal("🌟 Отличная работа, агент!", modalMsg);

        // Show Next Level Button
        const nextBtn = document.getElementById("next-level-btn");
        if (nextBtn && state.currentLevelIndex < LEVELS.length - 1) {
          nextBtn.classList.add("visible");
        }

        saveState();
        updateHeaderUI();
        renderLevelPickerGrid();

        const taskSingleText = document.getElementById("task-single-text");
        if (taskSingleText) {
          taskSingleText.innerHTML = '✅ ' + step.tasks[0].text;
        }
      } else {
        const remaining = step.tasks.filter(t => !state.completedTasks.includes(t.id));
        if (remaining.length > 0) {
          showModal("🔍 Проверка задания", `Сайт запущен на iPad! 📱\n\nЧтобы пройти этот уровень и получить XP:\n👉 ${remaining[0].text}`);
        } else {
          showModal("🎉 Уровень уже пройден!", "Все задачи этого уровня уже решены! Жми кнопку 'Дальше →' для продолжения.");
          document.getElementById("next-level-btn")?.classList.add("visible");
        }
      }
    }

    // Step / Level Navigation
    function nextLevel() {
      const currentLvl = LEVELS[state.currentLevelIndex];
      const mission = MISSIONS[currentLvl.missionId];
      const isLastStepOfMission = currentLvl.stepIndex === mission.steps.length - 1;

      // If at end of mission and haven't just completed its quiz:
      if (isLastStepOfMission && !quizState.justCompletedBlockQuiz[currentLvl.missionId]) {
        openQuizForBlock(currentLvl.missionId, true);
        return;
      }

      // Reset flag
      quizState.justCompletedBlockQuiz[currentLvl.missionId] = false;

      if (state.currentLevelIndex < LEVELS.length - 1) {
        playSound('click');
        loadLevel(state.currentLevelIndex + 1);
      } else {
        openDiploma();
      }
    }

    function prevLevel() {
      if (state.currentLevelIndex > 0) {
        playSound('click');
        loadLevel(state.currentLevelIndex - 1);
      }
    }

    // Quick Tag Helper
    function insertTag(startTag, endTag = "") {
      const textarea = document.getElementById("code-editor");
      if (!textarea) return;
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const text = textarea.value;
      const selected = text.substring(start, end);

      const replacement = startTag + selected + endTag;
      textarea.value = text.substring(0, start) + replacement + text.substring(end);

      textarea.focus();
      textarea.selectionStart = start + startTag.length;
      textarea.selectionEnd = start + startTag.length + selected.length;

      saveCurrentCode();
      playSound('click');
      updatePreview();
    }

    // Update Header XP & Info
    function updateHeaderUI() {
      const xpNum = document.getElementById("current-xp-num");
      if (xpNum) xpNum.textContent = state.xp.toString();

      const nameInp = document.getElementById("agent-name-input");
      if (nameInp) nameInp.value = state.agentName;

      const avatarBtn = document.getElementById("agent-avatar");
      if (avatarBtn) avatarBtn.textContent = state.avatar;
    }

    // -------------------------------------------------------------
    // MODALS: TAGS LIBRARY & DIPLOMA
    // -------------------------------------------------------------
    function renderTagsLibrary() {
      const grid = document.getElementById("tags-cards-grid");
      if (!grid) return;
      grid.innerHTML = "";

      ALL_TAGS.forEach(item => {
        const isLearned = state.xp >= item.missionLevel * 140;
        const card = document.createElement("div");
        card.style.cssText = `
          background: #ffffff;
          border: 1px solid ${isLearned ? '#bfdbfe' : '#e2e8f0'};
          border-radius: 14px;
          padding: 16px;
          display: flex;
          flex-direction: column;
          gap: 8px;
          box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        `;

        card.innerHTML = `
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="font-size: 20px;">${item.icon}</span>
              <code style="font-size: 13.5px; font-weight: 800; color: #1d4ed8; background: #eff6ff; padding: 2px 7px; border-radius: 6px;">${item.tag}</code>
            </div>
            <span style="font-size: 11px; font-weight: 800; color: ${isLearned ? '#059669' : '#94a3b8'}; background: ${isLearned ? '#ecfdf5' : '#f1f5f9'}; padding: 2px 7px; border-radius: 10px;">
              ${isLearned ? 'Изучено ✅' : `Дело №${item.missionLevel}`}
            </span>
          </div>
          <div style="font-size: 13.5px; font-weight: 800; color: #1e293b;">${item.name}</div>
          <div style="font-size: 12.5px; color: #475569; line-height: 1.45;">${item.analogy}</div>
          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px; font-family: var(--font-mono); font-size: 11.5px; color: #0f172a; white-space: pre-wrap;">${escapeHtml(item.example)}</div>
          <button class="btn-soft" style="align-self: flex-start; font-size: 11px; padding: 5px 10px;" onclick="copyTagExample('${escapeAttr(item.example)}')">
            📋 Скопировать пример
          </button>
        `;

        grid.appendChild(card);
      });
    }

    function escapeHtml(str) {
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function escapeAttr(str) {
      return str.replace(/'/g, "\\'").replace(/\n/g, "\\n");
    }

    window.copyTagExample = function(text) {
      navigator.clipboard.writeText(text).then(() => {
        playSound('click');
        showModal("📋 Скопировано!", "Код скопирован в буфер. Теперь можешь вставить его в окно редактора!");
      });
    };

    function openTagsModal() {
      playSound('click');
      renderTagsLibrary();
      document.getElementById("tags-library-container")?.classList.add("open");
    }

    function closeTagsModal() {
      playSound('click');
      document.getElementById("tags-library-container")?.classList.remove("open");
    }

    function openDiploma() {
      playSound('win');
      launchConfetti();
      const cert = document.getElementById("certificate-container");
      if (cert) cert.classList.add("open");

      const certName = document.getElementById("cert-agent-name");
      const certScore = document.getElementById("cert-xp-score");
      const certDate = document.getElementById("cert-date");

      if (certName) certName.textContent = state.agentName.toUpperCase();
      if (certScore) certScore.textContent = state.xp.toString();
      if (certDate) certDate.textContent = new Date().toLocaleDateString('ru-RU');
    }

    function closeDiploma() {
      playSound('click');
      document.getElementById("certificate-container")?.classList.remove("open");
    }

    function showModal(title, message) {
      const overlay = document.getElementById("modal-overlay");
      const titleEl = document.getElementById("modal-title");
      const bodyEl = document.getElementById("modal-body");
      if (titleEl) titleEl.textContent = title;
      if (bodyEl) bodyEl.textContent = message;
      if (overlay) overlay.classList.add("open");
    }

    function closeModal() {
      playSound('click');
      document.getElementById("modal-overlay")?.classList.remove("open");
    }

    // -------------------------------------------------------------
    // QUIZ CONTROLLER (ВИКТОРИНА ПОСЛЕ КАЖДОГО БЛОКА)
    // -------------------------------------------------------------
    const quizState = {
      activeBlockId: 0,
      currentQIdx: 0,
      userAnswers: [],
      autoNextOnFinish: false,
      justCompletedBlockQuiz: {}
    };

    function escapeHtml(str) {
      if (!str) return "";
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function openQuizForBlock(blockId, autoNext = false) {
      playSound('click');
      const quiz = BLOCK_QUIZZES[blockId] || BLOCK_QUIZZES[0];
      quizState.activeBlockId = blockId;
      quizState.currentQIdx = 0;
      quizState.userAnswers = [];
      quizState.autoNextOnFinish = autoNext;

      const titleEl = document.getElementById("quiz-block-title");
      if (titleEl) titleEl.textContent = quiz.blockTitle;

      const badgeEl = document.getElementById("quiz-badge");
      if (badgeEl) badgeEl.textContent = `🎯 ВИКТОРИНА: ДЕЛО №${blockId}`;

      const qView = document.getElementById("quiz-question-view");
      const rView = document.getElementById("quiz-result-view");
      if (qView) qView.style.display = "block";
      if (rView) rView.style.display = "none";

      renderQuizQuestion();
      document.getElementById("quiz-modal-overlay")?.classList.add("open");
    }

    function closeQuiz() {
      playSound('click');
      document.getElementById("quiz-modal-overlay")?.classList.remove("open");
    }

    function renderQuizQuestion() {
      const quiz = BLOCK_QUIZZES[quizState.activeBlockId];
      if (!quiz) return;
      const q = quiz.questions[quizState.currentQIdx];
      const total = quiz.questions.length;

      const stepText = document.getElementById("quiz-step-text");
      if (stepText) stepText.textContent = `Вопрос ${quizState.currentQIdx + 1} из ${total}`;

      const progressFill = document.getElementById("quiz-progress-fill");
      if (progressFill) {
        const pct = Math.round(((quizState.currentQIdx + 1) / total) * 100);
        progressFill.style.width = `${pct}%`;
      }

      const qNum = document.getElementById("quiz-q-num");
      if (qNum) qNum.textContent = `Вопрос ${quizState.currentQIdx + 1}:`;

      const qTitle = document.getElementById("quiz-q-title");
      if (qTitle) qTitle.textContent = q.question;

      const letters = ["А", "Б", "В", "Г"];
      const optionsList = document.getElementById("quiz-options-list");
      if (optionsList) {
        optionsList.innerHTML = q.options.map((opt, oIdx) => `
          <button class="quiz-option-btn" data-opt-idx="${oIdx}">
            <span class="quiz-opt-letter">${letters[oIdx] || oIdx + 1}</span>
            <span class="quiz-opt-text">${escapeHtml(opt)}</span>
          </button>
        `).join("");

        optionsList.querySelectorAll(".quiz-option-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            const idx = parseInt(btn.getAttribute("data-opt-idx") || "0", 10);
            handleQuizChoice(idx);
          });
        });
      }
    }

    function handleQuizChoice(choiceIdx) {
      playSound('click');
      quizState.userAnswers[quizState.currentQIdx] = choiceIdx;
      const quiz = BLOCK_QUIZZES[quizState.activeBlockId];

      quizState.currentQIdx++;
      if (quizState.currentQIdx < quiz.questions.length) {
        renderQuizQuestion();
      } else {
        renderQuizResults();
      }
    }

    function renderQuizResults() {
      const quiz = BLOCK_QUIZZES[quizState.activeBlockId];
      const qView = document.getElementById("quiz-question-view");
      const rView = document.getElementById("quiz-result-view");
      if (qView) qView.style.display = "none";
      if (rView) rView.style.display = "block";

      let correctCount = 0;
      quiz.questions.forEach((q, idx) => {
        if (quizState.userAnswers[idx] === q.correctIndex) {
          correctCount++;
        }
      });

      const iconEl = document.getElementById("quiz-result-icon");
      const headingEl = document.getElementById("quiz-result-heading");
      const scoreEl = document.getElementById("quiz-result-score");

      if (correctCount === quiz.questions.length) {
        launchConfetti();
        playSound('win');
        if (iconEl) iconEl.textContent = "🏆";
        if (headingEl) headingEl.textContent = "Идеальный результат, Спецагент!";
        if (scoreEl) scoreEl.textContent = `Правильных ответов: ${correctCount} из ${quiz.questions.length} (100%!) 🌟`;
        state.xp += 25;
        saveState();
        updateHeaderUI();
      } else if (correctCount >= 2) {
        playSound('win');
        if (iconEl) iconEl.textContent = "🎖️";
        if (headingEl) headingEl.textContent = "Отличная работа!";
        if (scoreEl) scoreEl.textContent = `Правильных ответов: ${correctCount} из ${quiz.questions.length} 👍`;
      } else {
        playSound('click');
        if (iconEl) iconEl.textContent = "🔍";
        if (headingEl) headingEl.textContent = "Есть над чем поработать!";
        if (scoreEl) scoreEl.textContent = `Правильных ответов: ${correctCount} из ${quiz.questions.length} — посмотри правильные ответы ниже!`;
      }

      const breakdownList = document.getElementById("quiz-breakdown-list");
      if (breakdownList) {
        breakdownList.innerHTML = quiz.questions.map((q, idx) => {
          const userChoice = quizState.userAnswers[idx];
          const isCorrect = userChoice === q.correctIndex;
          const userAnsText = q.options[userChoice] !== undefined ? q.options[userChoice] : "Не отвечено";
          const correctAnsText = q.options[q.correctIndex];

          return `
            <div class="quiz-breakdown-card ${isCorrect ? 'card-correct' : 'card-wrong'}">
              <div class="breakdown-top-line">
                <span class="breakdown-q-title">Вопрос ${idx + 1}: ${escapeHtml(q.question)}</span>
                <span class="breakdown-badge ${isCorrect ? 'badge-correct' : 'badge-wrong'}">
                  ${isCorrect ? '✅ Верно' : '❌ Ошибка'}
                </span>
              </div>
              <div class="breakdown-your-ans">
                <strong>Твой ответ:</strong> ${escapeHtml(userAnsText)}
              </div>
              ${!isCorrect ? `
                <div class="breakdown-correct-ans">
                  👉 <strong>Правильный ответ:</strong> ${escapeHtml(correctAnsText)}
                </div>
              ` : ''}
              <div class="breakdown-explanation">
                💡 <strong>Объяснение:</strong> ${escapeHtml(q.explanation)}
              </div>
            </div>
          `;
        }).join("");
      }
    }

    function retryQuiz() {
      playSound('click');
      quizState.currentQIdx = 0;
      quizState.userAnswers = [];
      const qView = document.getElementById("quiz-question-view");
      const rView = document.getElementById("quiz-result-view");
      if (rView) rView.style.display = "none";
      if (qView) qView.style.display = "block";
      renderQuizQuestion();
    }

    function resetGame() {
      if (confirm("Точно сбросить весь прогресс и начать все дела заново?")) {
        localStorage.clear();
        state.agentName = "Агент 007";
        state.avatar = "🕵️‍♂️";
        state.xp = 0;
        state.completedTasks = [];
        state.currentLevelIndex = 0;
        state.soundEnabled = true;
        saveState();
        loadLevel(0);
        playSound('click');
      }
    }

    // -------------------------------------------------------------
    // INITIALIZATION & EVENT LISTENERS
    // -------------------------------------------------------------
    function init() {
      const nameInp = document.getElementById("agent-name-input");
      const saveName = (e) => {
        state.agentName = e.target.value.trim() || "Агент 007";
        saveState();
      };
      nameInp?.addEventListener("input", saveName);
      nameInp?.addEventListener("change", saveName);

      const avatarBtn = document.getElementById("agent-avatar");
      const avatars = ["🕵️‍♂️", "🥷", "🦸‍♂️", "🐱", "🦁", "🦊", "🚀", "⚡"];
      avatarBtn?.addEventListener("click", () => {
        const idx = avatars.indexOf(state.avatar);
        state.avatar = avatars[(idx + 1) % avatars.length];
        if (avatarBtn) avatarBtn.textContent = state.avatar;
        saveState();
        playSound('click');
      });

      // Sound button
      const soundBtn = document.getElementById("sound-btn");
      if (soundBtn) {
        soundBtn.textContent = state.soundEnabled ? "🔊 Звук: ВКЛ" : "🔇 Звук: ВЫКЛ";
      }
      soundBtn?.addEventListener("click", () => {
        state.soundEnabled = !state.soundEnabled;
        soundBtn.textContent = state.soundEnabled ? "🔊 Звук: ВКЛ" : "🔇 Звук: ВЫКЛ";
        saveState();
        playSound('click');
      });

      // Level Picker Trigger
      document.getElementById("level-dropdown-btn")?.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleLevelPicker();
      });

      document.addEventListener("click", (e) => {
        const popover = document.getElementById("level-picker-popover");
        if (popover && !popover.contains(e.target) && e.target.id !== "level-dropdown-btn") {
          closeLevelPicker();
        }
      });

      // Top arrows
      document.getElementById("prev-level-btn")?.addEventListener("click", prevLevel);
      document.getElementById("next-level-btn-top")?.addEventListener("click", nextLevel);

      // Action buttons
      document.getElementById("run-code-btn")?.addEventListener("click", runCode);
      document.getElementById("check-code-btn")?.addEventListener("click", checkCode);
      document.getElementById("next-level-btn")?.addEventListener("click", nextLevel);
      document.getElementById("safari-reload-btn")?.addEventListener("click", runCode);

      // Footer Links
      document.getElementById("footer-tags-btn")?.addEventListener("click", openTagsModal);
      document.getElementById("back-to-missions-btn")?.addEventListener("click", closeTagsModal);
      document.getElementById("footer-cert-btn")?.addEventListener("click", openDiploma);
      document.getElementById("close-diploma-btn")?.addEventListener("click", closeDiploma);
      document.getElementById("print-diploma-btn")?.addEventListener("click", () => window.print());
      document.getElementById("reset-btn")?.addEventListener("click", resetGame);

      // Modal close
      document.getElementById("modal-close-btn")?.addEventListener("click", closeModal);

      // Quiz Listeners
      document.getElementById("footer-quiz-btn")?.addEventListener("click", () => {
        const curLvl = LEVELS[state.currentLevelIndex];
        openQuizForBlock(curLvl.missionId, false);
      });
      document.getElementById("quiz-close-x")?.addEventListener("click", closeQuiz);
      document.getElementById("quiz-retry-btn")?.addEventListener("click", retryQuiz);
      document.getElementById("quiz-continue-btn")?.addEventListener("click", () => {
        const autoNext = quizState.autoNextOnFinish;
        const missionId = quizState.activeBlockId;
        closeQuiz();
        if (autoNext) {
          quizState.justCompletedBlockQuiz[missionId] = true;
          nextLevel();
        }
      });

      // Quick stickers
      document.querySelectorAll(".sticker-pill-mini").forEach(btn => {
        btn.addEventListener("click", (e) => {
          const target = e.currentTarget;
          const start = target.getAttribute("data-start") || "";
          const end = target.getAttribute("data-end") || "";
          insertTag(start, end);
        });
      });

      // Code typing with live update
      let typingTimer;
      const editor = document.getElementById("code-editor");
      editor?.addEventListener("input", () => {
        saveCurrentCode();
        clearTimeout(typingTimer);
        typingTimer = setTimeout(updatePreview, 350);
      });

      // Auto-save on page hide/close
      window.addEventListener("beforeunload", () => {
        saveCurrentCode();
        saveState();
      });
      window.addEventListener("pagehide", () => {
        saveCurrentCode();
        saveState();
      });

      // Load initial level
      loadLevel(state.currentLevelIndex);
      updateHeaderUI();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</Layout>
