            stepId: "0-4",
            stepName: "Тело <body>",
            tag: "<body>",
            headline: "Шаг 4: Видимое тело сайта <body> — время творить!",
            explanation: "<b>&lt;body&gt;</b> — это тело сайта! Всё, что посетитель видит своими глазами на iPad (заголовки, текст, картинки, кнопки), живет строго между <code>&lt;body&gt;</code> и <code>&lt;/body&gt;</code>. Твой редактор кода находится прямо внутри него!<br><br>👉 Пора пробовать! Напиши свой первый заголовок <code>&lt;h1&gt;Штаб спецагента&lt;/h1&gt;</code> в поле редактора своими руками:",
            formula: "<body> Здесь пишется весь твой сайт! </body>",
            isIntroOnly: false,
            tasks: [
              { id: "0-4-1", text: "Напиши заголовок <h1>...</h1> своими руками внутри тела сайта", xp: 40, check: (code) => /<h1>\s*[^<>]+\s*<\/h1>/i.test(code) }
