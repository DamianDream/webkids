    // Temporary toast on iPad screen
    let toastTimer = null;
    function showIpadToast(message) {
      const toast = document.getElementById("ipad-run-toast");
      if (!toast) return;
      toast.textContent = message;
      toast.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.remove("show");
      }, 1400);
    }

    // Run Code only (renders live directly inside iPad)
    function runCode() {
      playSound('click');
      updatePreview();

      // Animate Safari reload icon
      const reloadIcon = document.getElementById("safari-reload-btn");
      if (reloadIcon) {
        reloadIcon.classList.remove("spinning");
        void reloadIcon.offsetWidth;
        reloadIcon.classList.add("spinning");
      }

      // Screen glow feedback
      const screen = document.querySelector(".ipad-vector-screen");
      if (screen) {
        screen.classList.add("screen-run-flash");
        setTimeout(() => screen.classList.remove("screen-run-flash"), 450);
      }

      showIpadToast("🚀 Сайт запущен на iPad!");
    }

    // Check Code with step validation
    function checkCode() {
      playSound('click');
      updatePreview();
      
      const mission = MISSIONS.find(m => m.id === state.currentMissionId);
      const currentStep = mission.steps[state.currentStepIndex];
      const textarea = document.getElementById("code-editor");
      const code = textarea ? textarea.value.trim() : "";
      
      let count = 0;
      let earnedXp = 0;

      currentStep.tasks.forEach(task => {
        if (!state.completedTasks.includes(task.id)) {
          if (task.check && task.check(code)) {
            state.completedTasks.push(task.id);
            state.xp += task.xp;
            earnedXp += task.xp;
            count++;
          }
        }
      });

      if (count > 0) {
        playSound('win');
        launchConfetti();
        showIpadToast(`🌟 Задание выполнено! +${earnedXp} XP`);
        const modalMessage = currentStep.isIntroOnly
          ? `Отлично! Ты успешно познакомился с тегом ${currentStep.tag}!\nЗачислено +${earnedXp} XP!\n\nНажми 'Следующий шаг →' внизу, чтобы продолжить изучение чертежа сайта.`
          : `Шифр проверен! Выполнено заданий: ${count}. Зачислено +${earnedXp} XP!\n\nТвой сайт отобразился на экране iPad! Нажми 'Следующий шаг →' для продолжения.`;
        showModal("🌟 Отличная работа, агент!", modalMessage);
        saveState();
        updateUI();
        renderCurrentStepTasks(currentStep);
        renderStepsTrack(mission, state.currentStepIndex);
      } else {
        const remaining = currentStep.tasks.filter(t => !state.completedTasks.includes(t.id));
        if (remaining.length > 0) {
          showModal("🔍 Проверка задания", `Сайт запущен на iPad! 📱\n\nЧтобы пройти проверку и получить XP:\n👉 ${remaining[0].text}`);
        } else {
          showModal("🎉 Этот шаг пройден!", "Все задачи этого шага уже решены! Жми кнопку 'Следующий шаг →' внизу.");
        }
      }
    }

    // Step Navigation
    function nextStep() {
      const mission = MISSIONS.find(m => m.id === state.currentMissionId);
      if (state.currentStepIndex < mission.steps.length - 1) {
        playSound('click');
        loadMission(mission.id, state.currentStepIndex + 1);
      } else {
        const curIdx = MISSIONS.findIndex(m => m.id === state.currentMissionId);
        if (curIdx < MISSIONS.length - 1) {
          const nextM = MISSIONS[curIdx + 1];
          if (state.xp >= nextM.minXp) {
            playSound('click');
            loadMission(nextM.id, 0);
          } else {
            showModal("🔒 Следующее дело пока закрыто", `Для открытия дела №${nextM.id} нужно набрать ${nextM.minXp} XP!`);
          }
        } else {
          showModal("🚀 Все дела Академии завершены!", "Поздравляем! Ты прошел весь курс. Открой вкладку '🏆 Диплом' и распечатай свой сертификат!");
        }
      }
    }

    function prevStep() {
      if (state.currentStepIndex > 0) {
        playSound('click');
        loadMission(state.currentMissionId, state.currentStepIndex - 1);
      }
    }

    // Quick Tag Helper
    function insertTag(startTag, endTag = "") {
      const textarea = document.getElementById("code-editor");
      if (!textarea) return;
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const text = textarea.value;
      const selected = text.substring(start, end);

      const replacement = startTag + selected + endTag;
      textarea.value = text.substring(0, start) + replacement + text.substring(end);

      textarea.focus();
      textarea.selectionStart = start + startTag.length;
      textarea.selectionEnd = start + startTag.length + selected.length;

      saveCurrentCode();
      playSound('click');
      updatePreview();
    }

    // -------------------------------------------------------------
    // TAGS LIBRARY (СПРАВОЧНИК ТЕГОВ)
    // -------------------------------------------------------------
    function renderTagsLibrary() {
      const grid = document.getElementById("tags-cards-grid");
      if (!grid) return;
      grid.innerHTML = "";

      ALL_TAGS.forEach(item => {
        const isLearned = state.xp >= item.missionLevel * 150;
        const card = document.createElement("div");
        card.style.cssText = `
          background: #ffffff;
          border: 1px solid ${isLearned ? '#bfdbfe' : '#e2e8f0'};
          border-radius: 16px;
          padding: 18px 20px;
          display: flex;
          flex-direction: column;
          gap: 10px;
          box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        `;

        card.innerHTML = `
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="font-size: 24px;">${item.icon}</span>
              <code style="font-size: 14px; font-weight: 800; color: #1d4ed8; background: #eff6ff; padding: 2px 8px; border-radius: 6px;">${item.tag}</code>
            </div>
            <span style="font-size: 11px; font-weight: 800; color: ${isLearned ? '#059669' : '#94a3b8'}; background: ${isLearned ? '#ecfdf5' : '#f1f5f9'}; padding: 3px 8px; border-radius: 12px;">
              ${isLearned ? 'Изучено ✅' : `Дело №${item.missionLevel}`}
            </span>
          </div>

          <div style="font-size: 14px; font-weight: 800; color: #1e293b;">${item.name}</div>
          <div style="font-size: 13.5px; color: #475569; line-height: 1.5;">${item.analogy}</div>

          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 10px; font-family: var(--font-mono); font-size: 12px; color: #0f172a; white-space: pre-wrap;">${escapeHtml(item.example)}</div>

          <button class="btn-soft" style="align-self: flex-start; font-size: 12px; padding: 6px 12px;" onclick="copyTagExample('${escapeAttr(item.example)}')">
            📋 Скопировать пример
          </button>
        `;

        grid.appendChild(card);
      });
    }

    function escapeHtml(str) {
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function escapeAttr(str) {
      return str.replace(/'/g, "\\'").replace(/\n/g, "\\n");
    }

    window.copyTagExample = function(text) {
      navigator.clipboard.writeText(text).then(() => {
        playSound('click');
        showModal("📋 Пример скопирован!", "Код скопирован в буфер обмена. Теперь можешь вставить его в окно редактора!");
      });
    };

    // Tab Switching
    function switchToTab(tab) {
      state.activeTab = tab;
      const workspace = document.getElementById("main-workspace");
      const tagsLib = document.getElementById("tags-library-container");
      const cert = document.getElementById("certificate-container");

      const navMissions = document.getElementById("nav-missions-btn");
      const navTags = document.getElementById("nav-tags-btn");

      if (workspace) workspace.style.display = tab === 'missions' ? "grid" : "none";
      if (tagsLib) tagsLib.style.display = tab === 'tags' ? "flex" : "none";
      if (cert) cert.style.display = tab === 'cert' ? "flex" : "none";

      if (navMissions) {
        navMissions.style.borderColor = tab === 'missions' ? "#3b82f6" : "#e2e8f0";
        navMissions.style.color = tab === 'missions' ? "#1d4ed8" : "#0f172a";
      }
      if (navTags) {
        navTags.style.borderColor = tab === 'tags' ? "#3b82f6" : "#e2e8f0";
        navTags.style.color = tab === 'tags' ? "#1d4ed8" : "#0f172a";
      }

      if (tab === 'tags') {
        renderTagsLibrary();
      }
      playSound('click');
    }

    // Modal
    function showModal(title, message) {
      const overlay = document.getElementById("modal-overlay");
      const titleEl = document.getElementById("modal-title");
      const bodyEl = document.getElementById("modal-body");
      if (titleEl) titleEl.textContent = title;
      if (bodyEl) bodyEl.textContent = message;
      if (overlay) overlay.classList.add("open");
    }

    function closeModal() {
      playSound('click');
      document.getElementById("modal-overlay")?.classList.remove("open");
    }

    // Certificate
    function openDiploma() {
      playSound('win');
      launchConfetti();
      switchToTab('cert');

      const certName = document.getElementById("cert-agent-name");
      const certScore = document.getElementById("cert-xp-score");
      const certDate = document.getElementById("cert-date");

      if (certName) certName.textContent = state.agentName.toUpperCase();
      if (certScore) certScore.textContent = state.xp.toString();
      if (certDate) certDate.textContent = new Date().toLocaleDateString('ru-RU');
    }

    // Save & Reset State in Browser Storage
    function saveState() {
      try {
        localStorage.setItem("astro_agent_name", state.agentName);
        localStorage.setItem("astro_avatar", state.avatar);
        localStorage.setItem("astro_xp", state.xp.toString());
        localStorage.setItem("astro_tasks", JSON.stringify(state.completedTasks));
        localStorage.setItem("astro_current_mission", state.currentMissionId.toString());
        localStorage.setItem("astro_current_step", state.currentStepIndex.toString());
        localStorage.setItem("astro_sound", state.soundEnabled ? "true" : "false");
        localStorage.setItem("astro_active_tab", state.activeTab);
      } catch (e) {
        console.warn("Storage save error", e);
      }
    }

    function resetGame() {
      if (confirm("Точно сбросить весь прогресс и начать все дела заново?")) {
        localStorage.clear();
        state.agentName = "Агент 007";
        state.avatar = "🕵️‍♂️";
        state.xp = 0;
        state.completedTasks = [];
        state.currentMissionId = 0;
        state.currentStepIndex = 0;
        state.soundEnabled = true;
        state.activeTab = "missions";
        saveState();
        switchToTab('missions');
        loadMission(0, 0);
        updateUI();
        playSound('click');
      }
    }

    // Attach Event Listeners
    function init() {
      const nameInp = document.getElementById("agent-name-input");
      const saveName = (e) => {
        state.agentName = e.target.value.trim() || "Агент 007";
        saveState();
      };
      nameInp?.addEventListener("input", saveName);
      nameInp?.addEventListener("change", saveName);

      const avatarBtn = document.getElementById("agent-avatar");
      const avatars = ["🕵️‍♂️", "🥷", "🦸‍♂️", "🐱", "🦁", "🦊", "🚀", "⚡"];
      avatarBtn?.addEventListener("click", () => {
        const idx = avatars.indexOf(state.avatar);
        state.avatar = avatars[(idx + 1) % avatars.length];
        if (avatarBtn) avatarBtn.textContent = state.avatar;
        saveState();
        playSound('click');
      });

      const soundBtn = document.getElementById("sound-btn");
      if (soundBtn) {
        soundBtn.textContent = state.soundEnabled ? "🔊" : "🔇";
        soundBtn.title = state.soundEnabled ? "Звук: ВКЛ" : "Звук: ВЫКЛ";
      }
      soundBtn?.addEventListener("click", () => {
        state.soundEnabled = !state.soundEnabled;
        soundBtn.textContent = state.soundEnabled ? "🔊" : "🔇";
        soundBtn.title = state.soundEnabled ? "Звук: ВКЛ" : "Звук: ВЫКЛ";
        saveState();
        playSound('click');
      });

      document.getElementById("nav-missions-btn")?.addEventListener("click", () => switchToTab('missions'));
      document.getElementById("nav-tags-btn")?.addEventListener("click", () => switchToTab('tags'));
      document.getElementById("back-to-missions-btn")?.addEventListener("click", () => switchToTab('missions'));
      document.getElementById("cert-open-btn")?.addEventListener("click", openDiploma);
      document.getElementById("close-diploma-btn")?.addEventListener("click", () => switchToTab('missions'));
      document.getElementById("print-diploma-btn")?.addEventListener("click", () => window.print());
      document.getElementById("reset-btn")?.addEventListener("click", resetGame);

      document.getElementById("run-code-btn")?.addEventListener("click", runCode);
      document.getElementById("check-code-btn")?.addEventListener("click", checkCode);
      document.getElementById("check-tasks-btn")?.addEventListener("click", checkCode);
      document.getElementById("next-step-btn")?.addEventListener("click", nextStep);
      document.getElementById("prev-step-btn")?.addEventListener("click", prevStep);
      document.getElementById("modal-close-btn")?.addEventListener("click", closeModal);
      document.getElementById("safari-reload-btn")?.addEventListener("click", () => {
        runCode();
      });

      document.querySelectorAll(".sticker-pill-mini").forEach(btn => {
        btn.addEventListener("click", (e) => {
          const target = e.currentTarget;
          const start = target.getAttribute("data-start") || "";
          const end = target.getAttribute("data-end") || "";
          insertTag(start, end);
        });
      });

      let typingTimer;
      const editor = document.getElementById("code-editor");
      editor?.addEventListener("input", () => {
        saveCurrentCode();
        clearTimeout(typingTimer);
        typingTimer = setTimeout(updatePreview, 350);
      });

      // Save on browser tab close / refresh / navigation
      window.addEventListener("beforeunload", () => {
        saveCurrentCode();
        saveState();
      });
      window.addEventListener("pagehide", () => {
        saveCurrentCode();
        saveState();
      });

      // Restore exact active mission & step
      loadMission(state.currentMissionId, state.currentStepIndex);
      if (state.activeTab && state.activeTab !== 'missions') {
        switchToTab(state.activeTab);
      }
      updateUI();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</Layout>
