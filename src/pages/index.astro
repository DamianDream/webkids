    // -------------------------------------------------------------
    // LOCAL STATE (RESTORED FROM BROWSER STORAGE)
    // -------------------------------------------------------------
    let savedMission = parseInt(localStorage.getItem("astro_current_mission") || "0", 10);
    if (isNaN(savedMission) || !MISSIONS.some(m => m.id === savedMission)) savedMission = 0;

    let savedStep = parseInt(localStorage.getItem("astro_current_step") || "0", 10);
    const targetMission = MISSIONS.find(m => m.id === savedMission);
    if (isNaN(savedStep) || savedStep < 0 || (targetMission && savedStep >= targetMission.steps.length)) savedStep = 0;

    let state = {
      agentName: localStorage.getItem("astro_agent_name") || "Агент 007",
      avatar: localStorage.getItem("astro_avatar") || "🕵️‍♂️",
      currentMissionId: savedMission,
      currentStepIndex: savedStep,
      xp: parseInt(localStorage.getItem("astro_xp") || "0", 10),
      completedTasks: JSON.parse(localStorage.getItem("astro_tasks") || "[]"),
      soundEnabled: localStorage.getItem("astro_sound") !== "false",
      activeTab: localStorage.getItem("astro_active_tab") || "missions" // "missions" | "tags" | "cert"
    };

    // Audio Synthesizer
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    let audioCtx = null;

    function playSound(type) {
      if (!state.soundEnabled) return;
      try {
        if (!audioCtx) audioCtx = new AudioContextClass();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const now = audioCtx.currentTime;

        if (type === 'click') {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.type = 'sine';
          osc.frequency.setValueAtTime(520, now);
          osc.frequency.exponentialRampToValueAtTime(320, now + 0.04);
          gain.gain.setValueAtTime(0.08, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.04);
          osc.start(now);
          osc.stop(now + 0.04);
        } else if (type === 'xp') {
          [523.25, 659.25, 783.99].forEach((f, i) => {
            const o = audioCtx.createOscillator();
            const g = audioCtx.createGain();
            o.connect(g);
            g.connect(audioCtx.destination);
            o.type = 'sine';
            o.frequency.setValueAtTime(f, now + i * 0.07);
            g.gain.setValueAtTime(0.12, now + i * 0.07);
            g.gain.linearRampToValueAtTime(0.01, now + i * 0.07 + 0.2);
            o.start(now + i * 0.07);
            o.stop(now + i * 0.07 + 0.2);
          });
        } else if (type === 'win') {
          [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => {
            const o = audioCtx.createOscillator();
            const g = audioCtx.createGain();
            o.connect(g);
            g.connect(audioCtx.destination);
            o.type = 'triangle';
            o.frequency.setValueAtTime(f, now + i * 0.09);
            g.gain.setValueAtTime(0.15, now + i * 0.09);
            g.gain.linearRampToValueAtTime(0.01, now + i * 0.09 + 0.3);
            o.start(now + i * 0.09);
            o.stop(now + i * 0.09 + 0.3);
          });
        }
      } catch (e) {
        console.error(e);
      }
    }

    // Confetti
    function launchConfetti() {
      const canvas = document.getElementById("confetti-canvas");
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const particles = [];
      const colors = ["#38bdf8", "#10b981", "#f59e0b", "#f43f5e", "#8b5cf6", "#ec4899"];

      for (let i = 0; i < 75; i++) {
        particles.push({
          x: canvas.width / 2,
          y: canvas.height / 2,
          vx: (Math.random() - 0.5) * 14,
          vy: (Math.random() - 0.7) * 16,
          size: Math.random() * 8 + 5,
          color: colors[Math.floor(Math.random() * colors.length)],
          alpha: 1,
          rot: Math.random() * 360,
          rotSpd: (Math.random() - 0.5) * 8
        });
      }

      function step() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        let active = 0;
        particles.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.35;
          p.alpha -= 0.012;
          p.rot += p.rotSpd;
          if (p.alpha > 0) {
            active++;
            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate((p.rot * Math.PI) / 180);
            ctx.fillStyle = p.color;
            ctx.globalAlpha = Math.max(0, p.alpha);
            ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
            ctx.restore();
          }
        });
        if (active > 0) requestAnimationFrame(step);
        else ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
      requestAnimationFrame(step);
    }

    // Rank Calculation
    function getRank(xp) {
      if (xp >= 1500) return { title: "Глава Кибер-Академии 👑", pct: 100 };
      if (xp >= 1100) return { title: "Секретный Архитектор 🛡️", pct: Math.round((xp / 1500) * 100) };
      if (xp >= 750)  return { title: "Мастер Порталов 🌀", pct: Math.round((xp / 1500) * 100) };
      if (xp >= 400)  return { title: "Кибер-Детектив 💻", pct: Math.round((xp / 1500) * 100) };
      if (xp >= 150)  return { title: "Младший Декодер 🔍", pct: Math.round((xp / 1500) * 100) };
      return { title: "Стажёр-Шпион 🕶️", pct: Math.round((xp / 1500) * 100) };
    }

    // Update Header & General UI
    function updateUI() {
      const nameInput = document.getElementById("agent-name-input");
      if (nameInput) nameInput.value = state.agentName;

      const avatarBtn = document.getElementById("agent-avatar");
      if (avatarBtn) avatarBtn.textContent = state.avatar;

      const rank = getRank(state.xp);
      const rankEl = document.getElementById("agent-rank");
      if (rankEl) rankEl.textContent = rank.title;

      const xpNum = document.getElementById("current-xp-num");
      if (xpNum) xpNum.textContent = state.xp.toString();

      const xpBar = document.getElementById("xp-bar-fill");
      if (xpBar) xpBar.style.width = Math.min(100, rank.pct) + "%";

      renderSidebar();
      renderTagsLibrary();
    }

    // Render Sidebar Cases
    function renderSidebar() {
      const sidebar = document.getElementById("missions-list");
      if (!sidebar) return;
      sidebar.innerHTML = "";

      MISSIONS.forEach(mission => {
        const isUnlocked = state.xp >= mission.minXp || mission.id === 0;
        const allTasks = mission.steps.flatMap(s => s.tasks);
        const allDone = allTasks.every(t => state.completedTasks.includes(t.id));

        const card = document.createElement("div");
        card.className = "case-card" + (mission.id === state.currentMissionId && state.activeTab === 'missions' ? " active" : "") + (!isUnlocked ? " locked" : "") + (allDone ? " completed" : "");
        
        card.innerHTML = `
          <div class="case-top">
            <span class="case-num">ДЕЛО №${mission.id}</span>
            <span>${allDone ? '✅' : (!isUnlocked ? '🔒' : '🎯')}</span>
          </div>
          <div class="case-name">${mission.title}</div>
          <div class="case-meta">
            <span>⭐ +${mission.rewardXp} XP</span>
            <span style="color: #64748b;">${mission.steps.length} шага</span>
          </div>
        `;

        if (isUnlocked) {
          card.onclick = () => {
            playSound('click');
            switchToTab('missions');
            loadMission(mission.id, 0);
          };
        }
        sidebar.appendChild(card);
      });
    }

    // Save currently written editor code
    function saveCurrentCode() {
      try {
        const textarea = document.getElementById("code-editor");
        if (textarea && state.currentMissionId !== undefined && state.currentStepIndex !== undefined) {
          const key = `astro_code_m_${state.currentMissionId}_s_${state.currentStepIndex}`;
          localStorage.setItem(key, textarea.value);
        }
      } catch (e) {
        console.warn("Storage save error", e);
      }
    }

    // Load Mission & Step
    function loadMission(id, stepIndex = 0) {
      saveCurrentCode();

      state.currentMissionId = id;
      state.currentStepIndex = stepIndex;
      saveState();

      const mission = MISSIONS.find(m => m.id === id);
      if (!mission) return;

      const currentStep = mission.steps[stepIndex] || mission.steps[0];

      // Update Header Badge & Titles
      const badgeEl = document.getElementById("briefing-badge");
      if (badgeEl) badgeEl.textContent = `ДЕЛО №00${mission.id} // ${mission.badge}`;

      // Update Step Focus Card
      document.getElementById("step-icon").textContent = currentStep.icon;
      document.getElementById("step-headline").textContent = currentStep.headline;
      document.getElementById("step-explanation").innerHTML = currentStep.explanation;
      document.getElementById("step-formula").textContent = currentStep.formula;

      // Update Safari URL to match mission
      const urlText = document.getElementById("safari-url-text");
      if (urlText) urlText.textContent = `agent-net.secret/case-${id}-step-${stepIndex + 1}.html`;

      // Render Step Track Pills
      renderStepsTrack(mission, stepIndex);

      // Load saved code from localStorage for this mission and step!
      const savedCodeKey = `astro_code_m_${id}_s_${stepIndex}`;
      const code = localStorage.getItem(savedCodeKey) || "";
      
      const textarea = document.getElementById("code-editor");
      if (textarea) {
        textarea.value = code;
        if (currentStep.isIntroOnly) {
          textarea.placeholder = "🔍 Пункт только для ознакомления. Писать код не требуется — просто нажми 'Проверить' (+XP)!";
        } else {
          textarea.placeholder = "Напиши теги своими руками здесь...";
        }
      }

      // Dynamic Skeleton Highlights for Mission 0
      document.querySelectorAll(".locked-html-skeleton div, .locked-html-skeleton-bottom div").forEach(el => el.classList.remove("skel-active"));
      if (id === 0) {
        if (stepIndex === 0) {
          document.getElementById("skel-doctype")?.classList.add("skel-active");
        } else if (stepIndex === 1) {
          document.getElementById("skel-html")?.classList.add("skel-active");
          document.getElementById("skel-html-end")?.classList.add("skel-active");
        } else if (stepIndex === 2) {
          document.getElementById("skel-head")?.classList.add("skel-active");
        } else if (stepIndex === 3) {
          document.getElementById("skel-body")?.classList.add("skel-active");
          document.getElementById("skel-body-end")?.classList.add("skel-active");
        }
      }

      renderCurrentStepTasks(currentStep);
      updatePreview();
      updateUI();
    }

    // Render Steps Buttons
    function renderStepsTrack(mission, activeIndex) {
      const track = document.getElementById("steps-track");
      if (!track) return;
      track.innerHTML = "";

      mission.steps.forEach((step, idx) => {
        const stepDone = step.tasks.every(t => state.completedTasks.includes(t.id));
        const btn = document.createElement("button");
        btn.className = "sticker-pill-mini" + (idx === activeIndex ? " active" : "");
        btn.style.cssText = idx === activeIndex 
          ? "background: #2563eb; color: #ffffff; border-color: #1d4ed8; font-weight: 800;"
          : (stepDone ? "background: #ecfdf5; color: #047857; border-color: #a7f3d0;" : "background: #ffffff;");
        
        btn.innerHTML = `${stepDone ? '✅ ' : ''}${step.stepName}`;
        btn.onclick = () => {
          playSound('click');
          loadMission(mission.id, idx);
        };
        track.appendChild(btn);
      });
    }

    // Render Tasks of the current step
    function renderCurrentStepTasks(currentStep) {
      const container = document.getElementById("tasks-container");
      if (!container) return;
      container.innerHTML = "";

      currentStep.tasks.forEach(task => {
        const isDone = state.completedTasks.includes(task.id);
        const row = document.createElement("div");
        row.className = "task-row" + (isDone ? " done" : "");
        row.innerHTML = `
          <div class="task-left-part">
            <input type="checkbox" class="task-box-check" ${isDone ? 'checked' : ''} data-id="${task.id}" />
            <span class="task-label-text">${task.text}</span>
          </div>
          <span class="task-xp-pill">+${task.xp} XP</span>
        `;

        const check = row.querySelector(".task-box-check");
        check.onchange = (e) => toggleTask(task, e.target.checked);
        container.appendChild(row);
      });
    }

    // Toggle Task & XP
    function toggleTask(task, checked) {
      if (checked) {
        if (!state.completedTasks.includes(task.id)) {
          state.completedTasks.push(task.id);
          state.xp += task.xp;
          playSound('xp');
          launchConfetti();
          showModal("🎉 Задание выполнено!", `Отлично сработано! Получено +${task.xp} XP за подвиг:\n"${task.text}"`);
        }
      } else {
        state.completedTasks = state.completedTasks.filter(id => id !== task.id);
        state.xp = Math.max(0, state.xp - task.xp);
      }
      saveState();
      updateUI();
      const mission = MISSIONS.find(m => m.id === state.currentMissionId);
      const currentStep = mission.steps[state.currentStepIndex];
      renderCurrentStepTasks(currentStep);
      renderStepsTrack(mission, state.currentStepIndex);
    }

