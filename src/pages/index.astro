---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Workspace from '../components/Workspace.astro';
import TagsLibrary from '../components/TagsLibrary.astro';
import Certificate from '../components/Certificate.astro';
import Modal from '../components/Modal.astro';
---

<Layout title="Академия Веб-Агентов | Интерактивный тренажер HTML + CSS">
  <Header />

  <div class="main-layout">
    <Sidebar />
    <Workspace />
    <TagsLibrary />
    <Certificate />
  </div>

  <Modal />

