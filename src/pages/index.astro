          {
            stepId: "3-1",
            stepName: "Рюкзак <ul>",
            tag: "<ul>",
            headline: "Шпионский список: Создай контейнер <ul>",
            explanation: "Перед выходом на миссию проверим экипировку! Списки в вебе создаются парным тегом <b>&lt;ul&gt;&lt;/ul&gt;</b> (Unordered List).",
            formula: "<ul> ... </ul>",
            tasks: [
              { id: "3-1-1", text: "Напиши тег списка <ul></ul> в редакторе", xp: 50, check: (code) => /<ul>[\s\S]*<\/ul>/i.test(code) }
            ]
          },
          {
            stepId: "3-2",
            stepName: "Предмет <li>",
            tag: "<li>",
            headline: "Вещи агента: Добавь пункты <li>",
