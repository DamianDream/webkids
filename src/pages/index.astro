            formula: "<img src='...' width='240'>",
            tasks: [
              { id: "4-1-1", text: "Добавь тег <img> с атрибутом src", xp: 60, check: (code) => /<img[^>]+src=['"][^'"]+['"][^>]*>/i.test(code) }
            ]
          },
          {
            stepId: "4-2",
            stepName: "Портал <a>",
            tag: "<a>",
            headline: "Секретный портал: Гиперссылка с тегом <a>",
            explanation: "Тег <b>&lt;a&gt;</b> создает кликабельную ссылку-телепорт! Адрес назначения пишется внутри атрибута <code>href='...'</code>.",
            formula: "<a href='https://...'>Текст ссылки</a>",
            tasks: [
              { id: "4-2-1", text: "Создай рабочую ссылку <a href='...'>...</a>", xp: 60, check: (code) => /<a[^>]+href=['"][^'"]+['"][^>]*>[\s\S]+?<\/a>/i.test(code) }
            ]
          }
        ]
      },
      {
        id: 5,
        title: "Цвета и лазерная кнопка",
        badge: "Инженер Лаборатории 🎨",
