    // -------------------------------------------------------------
    // FLATTENED 15 CONTINUOUS LEVELS (FLEXBOX FROGGY STYLE)
    // -------------------------------------------------------------
    const LEVELS = [];
    MISSIONS.forEach(mission => {
      mission.steps.forEach((step, sIdx) => {
        LEVELS.push({
          levelIndex: LEVELS.length, // 0..14
          levelNum: LEVELS.length + 1, // 1..15
          missionId: mission.id,
          stepIndex: sIdx,
          missionTitle: mission.title,
          missionBadge: mission.badge,
          stepName: step.stepName,
          step: step,
          minXp: mission.minXp
        });
      });
    });

