        missionLevel: 0
      },
      {
        tag: "<h1> ... </h1>",
        name: "Главный заголовок",
        icon: "📢",
        type: "HTML",
        analogy: "Самый громкий рупор страницы. Называй им штаб, базу или секретную операцию.",
        example: "<h1>Секретный Штаб Агента</h1>",
        missionLevel: 1
      },
      {
        tag: "<p> ... </p>",
        name: "Параграф (Абзац текста)",
        icon: "📄",
        type: "HTML",
        analogy: "Обычная строчка текста или абзац в донесении агента.",
