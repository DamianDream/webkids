    // Run Code only (renders live directly inside iPad)
    function runCode() {
      playSound('click');
      updatePreview();

      const reloadIcon = document.getElementById("safari-reload-btn");
      if (reloadIcon) {
        reloadIcon.classList.remove("spinning");
        void reloadIcon.offsetWidth;
