    let savedLevel = parseInt(localStorage.getItem("astro_current_level") || "0", 10);
    if (isNaN(savedLevel) || savedLevel < 0 || savedLevel >= LEVELS.length) {
      // Fallback from old keys if present
      const oldMission = parseInt(localStorage.getItem("astro_current_mission") || "0", 10);
      const oldStep = parseInt(localStorage.getItem("astro_current_step") || "0", 10);
      const found = LEVELS.find(l => l.missionId === oldMission && l.stepIndex === oldStep);
      savedLevel = found ? found.levelIndex : 0;
    }

    let state = {
      agentName: localStorage.getItem("astro_agent_name") || "Агент 007",
      avatar: localStorage.getItem("astro_avatar") || "🕵️‍♂️",
      currentLevelIndex: savedLevel,
      xp: parseInt(localStorage.getItem("astro_xp") || "0", 10),
      completedTasks: JSON.parse(localStorage.getItem("astro_tasks") || "[]"),
      soundEnabled: localStorage.getItem("astro_sound") !== "false"
    };

    // -------------------------------------------------------------
    // WEB AUDIO SYNTHESIZER
    // -------------------------------------------------------------
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    let audioCtx = null;

    function playSound(type) {
      if (!state.soundEnabled) return;
      try {
        if (!audioCtx) audioCtx = new AudioContextClass();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const now = audioCtx.currentTime;

        if (type === 'click') {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.type = 'sine';
          osc.frequency.setValueAtTime(540, now);
          osc.frequency.exponentialRampToValueAtTime(320, now + 0.04);
          gain.gain.setValueAtTime(0.08, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.04);
          osc.start(now);
          osc.stop(now + 0.04);
        } else if (type === 'xp') {
          [523.25, 659.25, 783.99].forEach((f, i) => {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(f, now + i * 0.06);
            gain.gain.setValueAtTime(0.1, now + i * 0.06);
            gain.gain.linearRampToValueAtTime(0.01, now + (i + 1) * 0.06);
            osc.start(now + i * 0.06);
            osc.stop(now + (i + 1) * 0.06);
          });
        } else if (type === 'win') {
          [440, 554.37, 659.25, 880].forEach((f, i) => {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.type = 'sine';
            osc.frequency.setValueAtTime(f, now + i * 0.09);
            gain.gain.setValueAtTime(0.12, now + i * 0.09);
            gain.gain.linearRampToValueAtTime(0.01, now + (i + 1) * 0.09);
            osc.start(now + i * 0.09);
            osc.stop(now + (i + 1) * 0.09);
          });
        }
      } catch (e) {
        // Audio suspended or blocked
      }
    }

    // -------------------------------------------------------------
    // CONFETTI CANNON
    // -------------------------------------------------------------
    function launchConfetti() {
      const canvas = document.getElementById("confetti-canvas");
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const particles = [];
      const colors = ['#2563eb', '#38bdf8', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6'];

      for (let i = 0; i < 90; i++) {
        particles.push({
          x: canvas.width / 2,
          y: canvas.height * 0.65,
          vx: (Math.random() - 0.5) * 16,
          vy: (Math.random() - 0.8) * 18,
          size: Math.random() * 8 + 4,
          color: colors[Math.floor(Math.random() * colors.length)],
          rot: Math.random() * 360,
          vrot: (Math.random() - 0.5) * 10,
          alpha: 1
        });
      }

      function step() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        let active = 0;
        particles.forEach(p => {
          if (p.alpha > 0) {
            active++;
            p.x += p.vx;
            p.y += p.vy;
            p.vy += 0.35;
            p.rot += p.vrot;
            p.alpha -= 0.012;

            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate((p.rot * Math.PI) / 180);
            ctx.fillStyle = p.color;
            ctx.globalAlpha = Math.max(0, p.alpha);
            ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
            ctx.restore();
          }
        });
        if (active > 0) requestAnimationFrame(step);
        else ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
      requestAnimationFrame(step);
    }

    // -------------------------------------------------------------
    // STORAGE SAVE & RESTORE
    // -------------------------------------------------------------
    function saveState() {
      try {
        localStorage.setItem("astro_agent_name", state.agentName);
        localStorage.setItem("astro_avatar", state.avatar);
        localStorage.setItem("astro_xp", state.xp.toString());
        localStorage.setItem("astro_tasks", JSON.stringify(state.completedTasks));
        localStorage.setItem("astro_current_level", state.currentLevelIndex.toString());
        localStorage.setItem("astro_sound", state.soundEnabled ? "true" : "false");
      } catch (e) {
        console.warn("Storage save error", e);
      }
    }

    function saveCurrentCode() {
      try {
        const textarea = document.getElementById("code-editor");
        if (textarea && state.currentLevelIndex !== undefined) {
          const key = `astro_code_lvl_${state.currentLevelIndex}`;
          localStorage.setItem(key, textarea.value);
        }
      } catch (e) {
        console.warn("Storage code save error", e);
      }
    }

    // -------------------------------------------------------------
    // LEVEL LOADING & RENDERING
    // -------------------------------------------------------------
    function loadLevel(lvlIndex) {
      if (lvlIndex < 0 || lvlIndex >= LEVELS.length) return;

      saveCurrentCode();
      state.currentLevelIndex = lvlIndex;
      saveState();

      const lvl = LEVELS[lvlIndex];
      const step = lvl.step;

      // Update Top Nav
      const levelDropdownText = document.getElementById("level-dropdown-text");
      if (levelDropdownText) {
        levelDropdownText.textContent = `Уровень ${lvl.levelNum} из ${LEVELS.length}`;
      }

      const prevBtn = document.getElementById("prev-level-btn");
      if (prevBtn) prevBtn.disabled = lvlIndex === 0;

      const nextTopBtn = document.getElementById("next-level-btn-top");
      if (nextTopBtn) nextTopBtn.disabled = lvlIndex === LEVELS.length - 1;

      // Update Instructions Area
      const badgeEl = document.getElementById("briefing-badge");
      if (badgeEl) badgeEl.textContent = `ДЕЛО №${lvl.missionId}: ${lvl.missionTitle}`;

      const headlineEl = document.getElementById("step-headline");
      if (headlineEl) headlineEl.textContent = step.headline;

      const explanationEl = document.getElementById("step-explanation");
      if (explanationEl) explanationEl.innerHTML = step.explanation;

      const formulaEl = document.getElementById("step-formula");
      if (formulaEl) formulaEl.textContent = step.formula;

      const taskSingleText = document.getElementById("task-single-text");
      if (taskSingleText && step.tasks && step.tasks.length > 0) {
        const isDone = step.tasks.every(t => state.completedTasks.includes(t.id));
        taskSingleText.innerHTML = (isDone ? '✅ ' : '🎯 ') + step.tasks[0].text;
      }

      // Update Safari URL to match current level
      const urlText = document.getElementById("safari-url-text");
      if (urlText) urlText.textContent = `agent-net.secret/level-${lvl.levelNum}.html`;

      // Update Code Editor with Saved Code
      const savedCodeKey = `astro_code_lvl_${lvlIndex}`;
      const legacyKey = `astro_code_m_${lvl.missionId}_s_${lvl.stepIndex}`;
      const code = localStorage.getItem(savedCodeKey) || localStorage.getItem(legacyKey) || "";

      const textarea = document.getElementById("code-editor");
      if (textarea) {
        textarea.value = code;
        if (step.isIntroOnly) {
          textarea.placeholder = "🔍 Пункт для ознакомления. Нажми кнопку 'Проверить' (+XP)!";
        } else {
          textarea.placeholder = "Напиши теги своими руками здесь...";
        }
      }

      // Skeleton Tag Highlights for Mission 0
      document.querySelectorAll(".code-locked-line").forEach(el => el.classList.remove("skel-active"));
      if (lvl.missionId === 0) {
        if (lvl.stepIndex === 0) {
          document.getElementById("skel-doctype")?.classList.add("skel-active");
        } else if (lvl.stepIndex === 1) {
          document.getElementById("skel-html")?.classList.add("skel-active");
          document.getElementById("skel-html-end")?.classList.add("skel-active");
        } else if (lvl.stepIndex === 2) {
          document.getElementById("skel-head")?.classList.add("skel-active");
        } else if (lvl.stepIndex === 3) {
          document.getElementById("skel-body")?.classList.add("skel-active");
          document.getElementById("skel-body-end")?.classList.add("skel-active");
        }
      }

      // Check if level already passed to show "Next" button
      const allTasksDone = step.tasks.every(t => state.completedTasks.includes(t.id));
      const nextBtn = document.getElementById("next-level-btn");
      if (nextBtn) {
        if (allTasksDone && lvlIndex < LEVELS.length - 1) {
          nextBtn.classList.add("visible");
        } else {
          nextBtn.classList.remove("visible");
        }
      }

      renderLevelPickerGrid();
      updatePreview();
      updateHeaderUI();
    }

    // -------------------------------------------------------------
    // LEVEL PICKER POPOVER (FROGGY LEVEL MENU)
    // -------------------------------------------------------------
    function renderLevelPickerGrid() {
      const grid = document.getElementById("level-picker-grid");
      if (!grid) return;
      grid.innerHTML = "";

      MISSIONS.forEach(mission => {
        const missionLevels = LEVELS.filter(l => l.missionId === mission.id);
        const group = document.createElement("div");
        group.className = "level-case-group";

        const label = document.createElement("div");
        label.className = "level-case-label";
        label.textContent = `Дело №${mission.id}: ${mission.title}`;
        group.appendChild(label);

        const row = document.createElement("div");
        row.className = "level-pills-row";

        missionLevels.forEach(lvl => {
          const isDone = lvl.step.tasks.every(t => state.completedTasks.includes(t.id));
          const isActive = lvl.levelIndex === state.currentLevelIndex;
          const isUnlocked = state.xp >= lvl.minXp || lvl.missionId === 0;

          const btn = document.createElement("button");
          btn.className = `level-pill-btn ${isActive ? 'active' : ''} ${isDone ? 'completed' : ''}`;
          btn.innerHTML = `${lvl.levelNum} ${isDone ? '✓' : (!isUnlocked ? '🔒' : '')}`;
          btn.title = `Уровень ${lvl.levelNum}: ${lvl.stepName}`;

          if (isUnlocked) {
            btn.onclick = () => {
              playSound('click');
              loadLevel(lvl.levelIndex);
              closeLevelPicker();
            };
          } else {
            btn.style.opacity = "0.4";
            btn.onclick = () => {
              showModal("🔒 Уровень закрыт", `Для доступа к Делу №${lvl.missionId} нужно набрать ${lvl.minXp} XP!`);
            };
          }
          row.appendChild(btn);
        });

        group.appendChild(row);
        grid.appendChild(group);
      });
    }

    function toggleLevelPicker() {
      const popover = document.getElementById("level-picker-popover");
      if (popover) {
        popover.classList.toggle("open");
        playSound('click');
      }
    }

    function closeLevelPicker() {
      document.getElementById("level-picker-popover")?.classList.remove("open");
    }

